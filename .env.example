# Copy to .env. Never commit .env (it is gitignored).

# Offline demo: bundled sample data, fixture workspace, rule-based reasoning.
# Set to false to connect to a real Databricks workspace with the values below.
DEMO_MODE=true

# Azure Databricks (live mode)
DATABRICKS_HOST=https://your-workspace.azuredatabricks.net
DATABRICKS_TOKEN=
DATABRICKS_CLUSTER_ID=

# Azure OpenAI (optional; without a key the agents use rule-based logic)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# App
DEBUG=false
LOG_LEVEL=INFO
AGENT_TIMEOUT_SECONDS=300

# Grafana admin password for docker compose (required by docker-compose.yml)
GRAFANA_ADMIN_PASSWORD=
